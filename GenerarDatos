def generar_ventas_region(metricas):
    """Distribuye el revenue real de Q2 2025 por región y especie."""
    total_revenue_q2 = metricas["q2_2025_revenue"]

    peso_region = {
        "Outback Central":     0.41,
        "Queensland":          0.29,
        "Nueva Gales del Sur": 0.20,
        "Victoria":            0.10,
    }
    peso_especie = {
        "Canguro rojo":    0.42,
        "Canguro gris":    0.39,
        "Wallaby":         0.16,
        "Canguro arbóreo": 0.03,
    }

    ticket_promedio = total_revenue_q2 / metricas["q2_2025_unidades"] if metricas["q2_2025_unidades"] > 0 else 162

    registros = []
    for region, pr in peso_region.items():
        for especie, pe in peso_especie.items():
            revenue = round(total_revenue_q2 * pr * pe * np.random.uniform(0.93, 1.07), 2)
            unidades = max(1, int(revenue / ticket_promedio))
            registros.append({
                "region":   region,
                "especie":  especie,
                "revenue":  revenue,
                "unidades": unidades,
            })
    return registros

