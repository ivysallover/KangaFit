# 4. REVIEWS (Conectadas al 30% de las ventas reales)
# ─────────────────────────────────────────────

def generar_reviews(ventas_mensuales):
    registros = []
    review_id = 1

    for v in ventas_mensuales:
        unidades = v["unidades"]
        # Calcula aprox el 30% de los pedidos de este registro específico
        num_reviews = int(unidades * np.random.uniform(0.28, 0.32))

        for _ in range(num_reviews):
            pid = v["producto_id"]
            
            # Asignamos un día al azar dentro del mes de la venta (del 1 al 28 para no complicar con febrero)
            dia = random.randint(1, 28)
            fecha = f"{v['anio']}-{v['mes']:02d}-{dia:02d}"

            rating = int(np.clip(np.round(np.random.normal(RATING_BASE[pid], 0.8)), 1, 5))
            es_positiva = rating >= 4

            if es_positiva:
                texto_template = random.choice(TEXTOS_REVIEWS_POS)
            else:
                texto_template = random.choice(TEXTOS_REVIEWS_NEG)

            texto = texto_template.replace("{producto}", v["producto_nombre"])

            registros.append({
                "id":              review_id,
                "fecha":           fecha,
                "cliente":         random.choice(NOMBRES_CLIENTES),
                "especie":         random.choice(ESPECIES),
                "region":          v["region"],
                "producto_id":     pid,
                "producto_nombre": v["producto_nombre"],
                "categoria":       v["categoria"],
                "rating":          rating,
                "texto":           texto,
                "verificada":      True,
                "respondida":      random.random() < 0.91,
            })
            review_id += 1

    return registros
