# 6. ESTADÍSTICAS DE REVIEWS
# ─────────────────────────────────────────────────────────────

def _filtrar_reviews_periodo(reviews, anio, q):
    rangos = {1: (1, 3), 2: (4, 6), 3: (7, 9), 4: (10, 12)}
    m0, m1 = rangos[q]
    return [r for r in reviews if int(r["fecha"][:4]) == anio and m0 <= int(r["fecha"][5:7]) <= m1]

def calcular_stats_reviews(reviews: list[dict]) -> dict:
    q1 = _filtrar_reviews_periodo(reviews, 2025, 1)
    q2 = _filtrar_reviews_periodo(reviews, 2025, 2)

    def distrib_ratings(subset):
        cnt = defaultdict(int)
        for r in subset:
            cnt[str(r["rating"])] += 1
        total = len(subset) or 1
        return {str(k): round(cnt[str(k)] / total * 100, 1) for k in range(5, 0, -1)}

    def contar_temas(subset):
        temas = {
            "Bolsillo marsupial": 0,
            "Comodidad en salto": 0,
            "Calidad de tela":    0,
            "Orificio / Costuras": 0,
            "Tallas / Ajuste":    0,
        }
        for r in subset:
            t = r["texto"].lower()
            if "bolsillo" in t:                         temas["Bolsillo marsupial"] += 1
            if "salto" in t or "sube" in t:             temas["Comodidad en salto"] += 1
            if "tela" in t or "transpirabilidad" in t:  temas["Calidad de tela"]    += 1
            if "costura" in t or "orificio" in t:       temas["Orificio / Costuras"] += 1
            if "talla" in t or "adapta" in t:           temas["Tallas / Ajuste"]    += 1
        return temas

    def rating_prom(subset):
        if not subset:
            return 0.0
        return round(sum(r["rating"] for r in subset) / len(subset), 2)

    def pct_respondidas(subset):
        if not subset:
            return 0.0
        return round(sum(1 for r in subset if r["respondida"]) / len(subset) * 100, 1)

    return {
        "reviews_total_q1":      len(q1),
        "reviews_total_q2":      len(q2),
        "rating_promedio_q2":    rating_prom(q2),
        "pct_respondidas_q2":    pct_respondidas(q2),
        "distribucion_ratings":  distrib_ratings(q2),
        "temas_reviews":         contar_temas(q2),
    }

# ─────────────────────────────────────────────────────────────
# 7. ESPECIES
# ─────────────────────────────────────────────────────────────

def calcular_especies(vm: list[dict]) -> list[dict]:
    def agg_especie(filtro):
        acc = defaultdict(lambda: {"rev": 0.0, "uni": 0})
        for r in vm:
            if filtro(r):
                acc[r["especie"]]["rev"] += r["revenue"]
                acc[r["especie"]]["uni"] += r["unidades"]
        return acc

    q1 = agg_especie(lambda r: _es_periodo(r, 2025, 1))
    q2 = agg_especie(lambda r: _es_periodo(r, 2025, 2))

    rev_esp_prod_q2 = defaultdict(lambda: defaultdict(float))
    for r in vm:
        if _es_periodo(r, 2025, 2):
            rev_esp_prod_q2[r["especie"]][r["producto_id"]] += r["revenue"]

    datos_extra = {
        "Canguro rojo":    {"region_principal": "Outback Central",      "estado": "Líder"},
        "Canguro gris":    {"region_principal": "Victoria / NSW",       "estado": "Estable"},
        "Wallaby":         {"region_principal": "Queensland",           "estado": "Emergente"},
        "Canguro arbóreo": {"region_principal": "Norte Queensland",     "estado": "En riesgo"},
    }

    resultado = []
    for especie in ESPECIES:
        rev_q2_esp = q2[especie]["rev"]
        uni_q2_esp = q2[especie]["uni"]
        rev_q1_esp = q1[especie]["rev"]

        ticket = round(rev_q2_esp / uni_q2_esp, 2) if uni_q2_esp > 0 else 0

        delta = (
            round((rev_q2_esp - rev_q1_esp) / rev_q1_esp * 100, 1)
            if rev_q1_esp > 0 else 0
        )

        prod_revs = rev_esp_prod_q2.get(especie, {})
        fav_id = max(prod_revs, key=prod_revs.get) if prod_revs else "SPP"
        fav_nombre = PROD_BY_ID[fav_id]["nombre"]
        fav_total  = sum(prod_revs.values()) or 1
        fav_pct    = round(prod_revs[fav_id] / fav_total * 100, 1)

        resultado.append({
            "especie":                especie,
            "ticket_promedio":        ticket,
            "unidades_q2":            uni_q2_esp,
            "revenue_q2":             round(rev_q2_esp, 2),
            "revenue_q1":             round(rev_q1_esp, 2),
            "delta_q1_pct":           delta,
            "producto_favorito":      fav_nombre,
            "pct_producto_favorito":  fav_pct,
            **datos_extra[especie],
        })

    return resultado

# ─────────────────────────────────────────────────────────────
# 8. KPIs GLOBALES
# ─────────────────────────────────────────────────────────────

def construir_kpis(m: dict, stats_rev: dict, devoluciones: list[dict]) -> dict:
    rev_q2 = m["q2_2025_revenue"]

    total_uni  = sum(d["unidades_vendidas_q2"] for d in devoluciones)
    total_dev  = sum(d["unidades_devueltas"]   for d in devoluciones)
    tasa_dev_real_q2 = round(total_dev / total_uni * 100, 1) if total_uni > 0 else 0
    tasa_dev_q1 = round(tasa_dev_real_q2 * random.uniform(0.82, 0.90), 1)

    canal_revenue = {
        "E-commerce propio":     round(rev_q2 * 0.46, 2),
        "Distribuidores outback": round(rev_q2 * 0.30, 2),
        "Tiendas físicas":       round(rev_q2 * 0.20, 2),
        "Sponsorships":          round(rev_q2 * 0.04, 2),
    }

    return {
        "revenue_total_q2":          rev_q2,
        "revenue_q1":                m["q1_2025_revenue"],
        "revenue_q2_2024":           m["rev_q2_2024"],
        "revenue_anual_2024":        m["rev_anual_2024"],
        "revenue_historico":         m["rev_historico"],
        "delta_q2_vs_q1_pct":        m["delta_q2_vs_q1_pct"],
        "delta_q2_yoy_pct":          m["delta_q2_yoy_pct"],
        "delta_unidades_pct":        m["delta_unidades_q2_vs_q1_pct"],
        "unidades_vendidas_q2":      m["q2_2025_unidades"],
        "unidades_q1":               m["q1_2025_unidades"],
        "ticket_promedio":           m["ticket_q2_2025"],
        "margen_bruto_pct":          61,
        "tasa_devolucion_q2":        tasa_dev_real_q2,
        "tasa_devolucion_q1":        tasa_dev_q1,
        "nps_q2":                    64,
        "nps_q1":                    60,
        "nps_por_especie": {
            "Canguro rojo":    73,
            "Canguro gris":    59,
            "Wallaby":         51,
            "Canguro arbóreo": 44,
        },
        "nps_promotores_pct":  72,
        "nps_pasivos_pct":     20,
        "nps_detractores_pct":  8,
        "skus_activos":        len(PRODUCTOS),
        "best_sellers":        ["Sports Pouch Pro™", "KangaPunch Boxing Gloves"],
        "atletas_patrocinados":       48,
        "mejora_promedio_salto_pct":  12,
        "retencion_sponsor_pct":      94,
        "record_salto_temporada":     14.2,
        "record_atleta":              "Big Red",
        "canal_revenue": canal_revenue,
        "reviews_total_q2":        stats_rev["reviews_total_q2"],
        "reviews_q1":              stats_rev["reviews_total_q1"],
        "rating_promedio":         stats_rev["rating_promedio_q2"],
        "reviews_respondidas_pct": stats_rev["pct_respondidas_q2"],
        "distribucion_ratings":    stats_rev["distribucion_ratings"],
        "temas_reviews":           stats_rev["temas_reviews"],
        "palabra_mas_usada":       "bolsillo",
    }

# ─────────────────────────────────────────────────────────────
# 9. ATLETAS
# ─────────────────────────────────────────────────────────────

def generar_atletas() -> list[dict]:
    resultado = []
    for a in ATLETAS_RAW:
        fav = max(PREF_ESPECIE[a["especie"]], key=PREF_ESPECIE[a["especie"]].get)
        resultado.append({
            **a,
            "salto_sin_kit":       round(a["salto_max"] / (1 + a["mejora_kit"]), 2),
            "mejora_kit_pct":      round(a["mejora_kit"] * 100, 1),
            "joeys_portados":      random.randint(0, 2) if a["especie"] != "Canguro arbóreo" else 0,
            "temporadas_activo":   random.randint(1, 12),
            "producto_preferido":  fav,
        })
    return resultado

