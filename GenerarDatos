# ─────────────────────────────────────────────────────────────
# EXPANSIÓN GEOGRÁFICA
# ─────────────────────────────────────────────────────────────

def regiones_activas(anio: int, mes: int) -> list[str]:
    r = ["Outback Central"]
    if anio > 2020 or (anio == 2020 and mes >= 8):
        r.append("Queensland")
    if anio > 2022 or (anio == 2022 and mes >= 3):
        r.append("Victoria")
    if anio > 2024 or (anio == 2024 and mes >= 11):
        r.append("Nueva Gales del Sur")
    return r

# ─────────────────────────────────────────────────────────────
# 1. VENTAS MENSUALES — fuente única de verdad
# ─────────────────────────────────────────────────────────────

def _ruido() -> float:
    return max(0.6, min(1.4, random.gauss(1.0, 0.12)))

def _base_unidades(mes_idx: int, total_meses: int) -> float:
    """ Curva de crecimiento S-logística calibrada para MARCA NICHO PREMIUM """
    k  = 600          # Capacidad máxima reducida (Exclusividad)
    x0 = total_meses * 0.55
    r  = 0.10         # Velocidad de crecimiento suave
    return k / (1 + math.exp(-r * (mes_idx - x0))) + 5

def generar_ventas_mensuales() -> list[dict]:
    registros = []
    inicio = datetime(2019, 5, 1)
    fin    = datetime(2026, 5, 1)
    total_meses = (fin.year - inicio.year) * 12 + fin.month - inicio.month

    mes_idx = 0
    for anio in range(2019, 2027):
        m_ini = 5 if anio == 2019 else 1
        m_fin = 5 if anio == 2026 else 12

        for mes in range(m_ini, m_fin + 1):
            base = _base_unidades(mes_idx, total_meses)
            factor_est = ESTACIONALIDAD[mes]
            regs_activas = regiones_activas(anio, mes)
            for region in regs_activas:
                mix_esp = MIX_ESPECIE_REGION[region]

                for especie, peso_esp in mix_esp.items():
                    pref = PREF_ESPECIE[especie]

                    for prod in PRODUCTOS:
                        pid = prod["id"]
                        peso_prod = pref[pid]
                        densidad = DENSIDAD_MERCADO[region]
                        u_raw = base * factor_est * densidad * peso_esp * peso_prod * _ruido()
                        unidades = max(0, round(u_raw))

                        if unidades == 0:
                            continue

                        revenue = round(unidades * prod["precio"] * random.uniform(0.97, 1.03), 2)

                        registros.append({
                            "anio":           anio,
                            "mes":            mes,
                            "mes_nombre":     datetime(anio, mes, 1).strftime("%b %Y"),
                            "region":         region,
                            "especie":        especie,
                            "producto_id":    pid,
                            "producto_nombre": prod["nombre"],
                            "categoria":      prod["categoria"],
                            "unidades":       unidades,
                            "revenue":        revenue,
                            "precio_unitario": prod["precio"],
                        })

            mes_idx += 1

    return registros

# ─────────────────────────────────────────────────────────────
# 2. AGREGADOS
# ─────────────────────────────────────────────────────────────

def _es_periodo(r, anio, q=None):
    if q is None:
        return r["anio"] == anio
    rangos = {1: (1, 3), 2: (4, 6), 3: (7, 9), 4: (10, 12)}
    m0, m1 = rangos[q]
    return r["anio"] == anio and m0 <= r["mes"] <= m1

def agregar(registros, filtro):
    rev = sum(r["revenue"]  for r in registros if filtro(r))
    uni = sum(r["unidades"] for r in registros if filtro(r))
    return rev, uni

def calcular_metricas(vm: list[dict]) -> dict:
    m = {}
    for q in [1, 2, 3, 4]:
        rev, uni = agregar(vm, lambda r, q=q: _es_periodo(r, 2025, q))
        m[f"q{q}_2025_revenue"]  = round(rev, 2)
        m[f"q{q}_2025_unidades"] = uni

    rev24, uni24 = agregar(vm, lambda r: _es_periodo(r, 2024))
    m["rev_anual_2024"] = round(rev24, 2)
    m["uni_anual_2024"] = uni24

    rev_hist = sum(r["revenue"] for r in vm)
    m["rev_historico"] = round(rev_hist, 2)

    m["ticket_q2_2025"] = (
        round(m["q2_2025_revenue"] / m["q2_2025_unidades"], 2)
        if m["q2_2025_unidades"] > 0 else 0
    )

    m["delta_q2_vs_q1_pct"] = (
        round((m["q2_2025_revenue"] - m["q1_2025_revenue"]) / m["q1_2025_revenue"] * 100, 1)
        if m["q1_2025_revenue"] > 0 else 0
    )
    m["delta_unidades_q2_vs_q1_pct"] = (
        round((m["q2_2025_unidades"] - m["q1_2025_unidades"]) / m["q1_2025_unidades"] * 100, 1)
        if m["q1_2025_unidades"] > 0 else 0
    )

    rev_q2_2024, _ = agregar(vm, lambda r: _es_periodo(r, 2024, 2))
    m["rev_q2_2024"] = round(rev_q2_2024, 2)
    m["delta_q2_yoy_pct"] = (
        round((m["q2_2025_revenue"] - rev_q2_2024) / rev_q2_2024 * 100, 1)
        if rev_q2_2024 > 0 else 0
    )

    return m

# ─────────────────────────────────────────────────────────────
# 3. VENTAS POR REGIÓN Y ESPECIE
# ─────────────────────────────────────────────────────────────

def agregar_region_especie(vm: list[dict]) -> list[dict]:
    acc = defaultdict(lambda: {"revenue": 0.0, "unidades": 0})
    for r in vm:
        if _es_periodo(r, 2025, 2):
            key = (r["region"], r["especie"])
            acc[key]["revenue"]  += r["revenue"]
            acc[key]["unidades"] += r["unidades"]

    return [
        {
            "region":   region,
            "especie":  especie,
            "revenue":  round(v["revenue"], 2),
            "unidades": v["unidades"],
        }
        for (region, especie), v in sorted(acc.items())
    ]

# ─────────────────────────────────────────────────────────────
# 4. DEVOLUCIONES
# ─────────────────────────────────────────────────────────────

def calcular_devoluciones(vm: list[dict]) -> list[dict]:
    ventas_q2 = defaultdict(lambda: {"unidades": 0, "revenue": 0.0})
    for r in vm:
        if _es_periodo(r, 2025, 2):
            ventas_q2[r["producto_id"]]["unidades"] += r["unidades"]
            ventas_q2[r["producto_id"]]["revenue"]  += r["revenue"]

    resultado = []
    for prod in PRODUCTOS:
        pid = prod["id"]
        uni_q2 = ventas_q2[pid]["unidades"]
        tasa   = TASA_DEV[pid]
        devueltas = round(uni_q2 * tasa)
        pesos = MOTIVOS_PESO.get(pid, MOTIVOS_PESO["_default"])

        motivos = {
            motivo: round(devueltas * p)
            for motivo, p in zip(MOTIVOS_DEV, pesos)
        }

        resultado.append({
            "producto_id":          pid,
            "producto_nombre":      prod["nombre"],
            "categoria":            prod["categoria"],
            "precio":               prod["precio"],
            "unidades_vendidas_q2": uni_q2,
            "unidades_devueltas":   devueltas,
            "tasa_devolucion":      round(tasa * 100, 1),
            "costo_devolucion":     round(devueltas * 38, 2),
            "motivos":              motivos,
        })

    return resultado

# ─────────────────────────────────────────────────────────────
# 5. REVIEWS — generadas desde ventas (~5-8 %)
# ─────────────────────────────────────────────────────────────

def generar_reviews(vm: list[dict]) -> list[dict]:
    registros = []
    rev_id = 1
    for v in vm:
        # RATIO REALISTA PREMIUM: 5% a 8%
        n = round(v["unidades"] * random.uniform(0.05, 0.08))
        for _ in range(n):
            pid    = v["producto_id"]
            rating = max(1, min(5, round(random.gauss(RATING_BASE[pid], 0.8))))
            
            # Elegimos de qué "bolsa" sacar el comentario
            pool_dict = REVIEWS_POS if rating >= 4 else REVIEWS_NEG
            # Unimos los comentarios específicos de ese producto + los genéricos
            pool = pool_dict.get(pid, pool_dict["_gen"]) + pool_dict["_gen"]
            
            texto  = random.choice(pool)
            texto  = texto.replace("{producto}", v["producto_nombre"])
            dia    = random.randint(1, 28)

            registros.append({
                "id":              rev_id,
                "fecha":           f"{v['anio']}-{v['mes']:02d}-{dia:02d}",
                "cliente":         random.choice(NOMBRES_CLIENTES),
                "especie":         v["especie"],
                "region":          v["region"],
                "producto_id":     pid,
                "producto_nombre": v["producto_nombre"],
                "categoria":       v["categoria"],
                "rating":          rating,
                "texto":           texto,
                "verificada":      True,
                "respondida":      random.random() < 0.91,
            })
            rev_id += 1

    return registros
