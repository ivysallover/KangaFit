# ─────────────────────────────────────────────
# 7. ESPECIES (segmentación Q2 2025) — coherentes con revenue real
# ─────────────────────────────────────────────

def generar_especies(metricas):
    rev_q2 = metricas["q2_2025_revenue"]
    uni_q2 = metricas["q2_2025_unidades"]
    ticket_q2 = rev_q2 / uni_q2 if uni_q2 > 0 else 162

    # Distribuciones fijas de revenue y unidades por especie
    dist_rev  = {"Canguro rojo": 0.489, "Canguro gris": 0.394,
                 "Wallaby": 0.133, "Canguro arbóreo": 0.035}
    dist_uni  = {"Canguro rojo": 0.419, "Canguro gris": 0.393,
                 "Wallaby": 0.161, "Canguro arbóreo": 0.027}

    datos_extra = {
        "Canguro rojo":    {"delta_q1_pct": 16, "region_principal": "Outback Central",
                            "producto_favorito": "Sports Pouch Pro™",
                            "pct_producto_favorito": 78, "estado": "Líder"},
        "Canguro gris":    {"delta_q1_pct":  8, "region_principal": "Victoria / NSW",
                            "producto_favorito": "KangaCore Legging",
                            "pct_producto_favorito": 62, "estado": "Estable"},
        "Wallaby":         {"delta_q1_pct": 43, "region_principal": "Queensland",
                            "producto_favorito": "KangaPunch Boxing Gloves",
                            "pct_producto_favorito": 49, "estado": "Emergente"},
        "Canguro arbóreo": {"delta_q1_pct": -2, "region_principal": "Norte Queensland",
                            "producto_favorito": "HopDry Tank",
                            "pct_producto_favorito": 38, "estado": "En riesgo"},
    }

    registros = []
    for especie in ESPECIES:
        rev_esp = round(rev_q2 * dist_rev[especie] * np.random.uniform(0.97, 1.03), 2)
        uni_esp = int(uni_q2 * dist_uni[especie] * np.random.uniform(0.97, 1.03))
        ticket_esp = round(rev_esp / uni_esp, 2) if uni_esp > 0 else ticket_q2
        registros.append({
            "especie":                especie,
            "ticket_promedio":        ticket_esp,
            "unidades_q2":            uni_esp,
            "revenue_q2":             rev_esp,
            **datos_extra[especie],
        })
    return registros
