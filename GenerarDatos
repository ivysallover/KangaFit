# ─────────────────────────────────────────────
# EXPANSIÓN GEOGRÁFICA PROGRESIVA
# ─────────────────────────────────────────────

def obtener_regiones_activas(anio, mes):
    """Simula la expansión territorial de la marca con el tiempo."""
    regiones = ["Outback Central"]
    if anio > 2020 or (anio == 2020 and mes >= 8):
        regiones.append("Queensland")
    if anio > 2022 or (anio == 2022 and mes >= 3):
        regiones.append("Victoria")
    if anio > 2024 or (anio == 2024 and mes >= 11):
        regiones.append("Nueva Gales del Sur")
    return regiones

# ─────────────────────────────────────────────
# 1. VENTAS MENSUALES (Mayo 2019 – Mayo 2026)
# ─────────────────────────────────────────────

def generar_ventas_mensuales():
    registros = []

    mes_inicio = datetime(2019, 5, 1)
    mes_actual = datetime(2026, 5, 1)
    total_meses = (mes_actual.year - mes_inicio.year) * 12 + mes_actual.month - mes_inicio.month

    for anio in range(2019, 2027):
        mes_arranque = 5 if anio == 2019 else 1
        mes_fin = 5 if anio == 2026 else 12

        for mes in range(mes_arranque, mes_fin + 1):
            mes_index = (anio - 2019) * 12 + mes - 5
            progreso = mes_index / total_meses if total_meses > 0 else 1
            base_unidades = 10 + 6500 * (progreso ** 3.2)
            factor_estac = ESTACIONALIDAD[mes]
            regiones_activas = obtener_regiones_activas(anio, mes)

            for prod in PRODUCTOS:
                pid = prod["id"]
                peso = PESO_VENTAS[pid]

                for region in regiones_activas:
                    unidades_crudas = (
                        base_unidades
                        * factor_estac
                        * peso
                        * (1 / len(regiones_activas))
                        * np.random.uniform(0.75, 1.25)
                    )
                    unidades = int(max(unidades_crudas, 0))

                    if unidades > 0:
                        revenue = round(
                            unidades * prod["precio"] * np.random.uniform(0.97, 1.03), 2
                        )
                        registros.append({
                            "anio":           anio,
                            "mes":            mes,
                            "mes_nombre":     datetime(anio, mes, 1).strftime("%b %Y"),
                            "region":         region,
                            "producto_id":    pid,
                            "producto_nombre":prod["nombre"],
                            "categoria":      prod["categoria"],
                            "unidades":       unidades,
                            "revenue":        revenue,
                            "precio_unitario":prod["precio"],
                        })
    return registros

# ─────────────────────────────────────────────
# HELPER: calcular KPIs reales desde ventas_mensuales
# ─────────────────────────────────────────────

def calcular_metricas_reales(ventas_mensuales):
    """
    Calcula revenue, unidades y ticket promedio reales por año/cuatrimestre
    directamente desde los registros de ventas.
    """
    def es_q(anio, mes, q_num):
        rangos = {1: (1,3), 2: (4,6), 3: (7,9), 4: (10,12)}
        m_ini, m_fin = rangos[q_num]
        return anio == 2025 and m_ini <= mes <= m_fin

    revenue_q = defaultdict(float)
    unidades_q = defaultdict(int)

    for v in ventas_mensuales:
        for q in [1, 2, 3, 4]:
            if es_q(v["anio"], v["mes"], q):
                revenue_q[q]  += v["revenue"]
                unidades_q[q] += v["unidades"]

    # Revenue anual 2024
    rev_2024 = sum(v["revenue"]  for v in ventas_mensuales if v["anio"] == 2024)
    uni_2024 = sum(v["unidades"] for v in ventas_mensuales if v["anio"] == 2024)
    # Revenue total histórico
    rev_hist = sum(v["revenue"]  for v in ventas_mensuales)

    return {
        "q1_2025_revenue":  round(revenue_q[1], 2),
        "q2_2025_revenue":  round(revenue_q[2], 2),
        "q3_2025_revenue":  round(revenue_q[3], 2),
        "q4_2025_revenue":  round(revenue_q[4], 2),
        "q1_2025_unidades": unidades_q[1],
        "q2_2025_unidades": unidades_q[2],
        "q3_2025_unidades": unidades_q[3],
        "q4_2025_unidades": unidades_q[4],
        "rev_anual_2024":   round(rev_2024, 2),
        "uni_anual_2024":   uni_2024,
        "rev_historico":    round(rev_hist, 2),
    }

